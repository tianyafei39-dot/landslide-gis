# 滑坡易发性评价 WebGIS 平台 —— 环境变量模板
# 复制为 backend/.env 后按需修改（.env 不入 git）
# 除 JWT_SECRET 必填外，其余均有内置默认值

# ===== JWT 认证（必填） =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== 管理员初始账号（首次启动自动创建） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 预留（当前版本未启用，保留兼容） =====
SIGN_SECRET=change-me-to-another-random-string
RESULT_URL_EXPIRE_SECONDS=600

# ===== 跨域（逗号分隔；Docker/nginx 同源部署时无需放开） =====
CORS_ORIGINS=http://localhost:5173

# ===== 训练并发闸门：同时最多几个训练任务真正在跑（默认 2） =====
TRAIN_MAX_CONCURRENT=2
